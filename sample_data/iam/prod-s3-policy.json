{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HelixProdLogsRead",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999988887777:role/payments-api-prod"
      },
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::helix-prod-logs",
        "arn:aws:s3:::helix-prod-logs/*"
      ]
    },
    {
      "Sid": "EnforceTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Condition": {
        "Bool": {"aws:SecureTransport": "false"}
      },
      "Resource": "arn:aws:s3:::helix-prod-logs/*"
    }
  ]
}
