{
  "Comment": "Cross-account IAM role allowing the analytics account (888877776666) to read production data in prod account (999988887777). Used by the dbt analytics pipeline for data extraction.",
  "RoleName": "helix-analytics-prod-read",
  "AccountId": "999988887777",
  "AssumedBy": "888877776666",
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::888877776666:role/dbt-pipeline-role"
        },
        "Action": "sts:AssumeRole",
        "Condition": {
          "StringEquals": {
            "sts:ExternalId": "helix-dbt-pipeline-2024"
          }
        }
      }
    ]
  },
  "Policies": [
    {
      "PolicyName": "helix-analytics-prod-read-policy",
      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "RDSDescribe",
            "Effect": "Allow",
            "Action": [
              "rds:DescribeDBInstances",
              "rds:DescribeDBClusters",
              "rds:DescribeDBSubnetGroups",
              "rds:DescribeDBSecurityGroups"
            ],
            "Resource": "*",
            "_comment": "SECURITY FINDING: DescribeDB* on Resource:* exposes metadata for ALL RDS instances including pii-prod-pg. Should be scoped to analytics replicas only."
          },
          {
            "Sid": "RDSConnect",
            "Effect": "Allow",
            "Action": "rds-db:connect",
            "Resource": [
              "arn:aws:rds-db:us-west-2:999988887777:dbuser:*/dbt_read",
              "arn:aws:rds-db:us-west-2:999988887777:dbuser:*/analytics_read"
            ],
            "_comment": "SECURITY FINDING: IAM auth for RDS connect scoped to user pattern, not specific DB instance ARNs. A new DB created with a 'dbt_read' user would automatically be accessible."
          },
          {
            "Sid": "S3ReadAnalytics",
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:ListBucket",
              "s3:GetBucketLocation"
            ],
            "Resource": [
              "arn:aws:s3:::helix-prod-analytics-staging",
              "arn:aws:s3:::helix-prod-analytics-staging/*",
              "arn:aws:s3:::helix-prod-logs",
              "arn:aws:s3:::helix-prod-logs/*"
            ]
          },
          {
            "Sid": "S3ListAll",
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*",
            "_comment": "SECURITY FINDING: ListAllMyBuckets exposes the names of ALL S3 buckets in the prod account, including sensitive bucket names like helix-prod-device-certs."
          },
          {
            "Sid": "CloudWatchReadLogs",
            "Effect": "Allow",
            "Action": [
              "logs:DescribeLogGroups",
              "logs:DescribeLogStreams",
              "logs:GetLogEvents",
              "logs:FilterLogEvents"
            ],
            "Resource": "arn:aws:logs:us-west-2:999988887777:log-group:/aws/rds/*",
            "_comment": "Acceptable: scoped to RDS log groups only."
          }
        ]
      }
    }
  ],
  "_audit_notes": {
    "last_reviewed": "2025-06-15",
    "reviewer": "raj.patel@helixrobotics.com",
    "findings": [
      "RDSDescribe on Resource:* should be scoped — HELIX-2098",
      "rds-db:connect scoped to user pattern not instance — HELIX-2099",
      "S3 ListAllMyBuckets grants bucket enumeration — HELIX-2100"
    ],
    "status": "open — review in progress"
  }
}
