flowchart TD
  subgraph internet["Internet"]
    OEMCustomer([OEM Customer\nWebhook subscriber])
    CustomerURL([Customer HTTPS Endpoint\nUnvalidated external URL\nSSRF risk HELIX-1822])
    IMDS([EC2 Instance Metadata\n169.254.169.254\nIMDSv2 required])
  end

  subgraph vpc["VPC — prod account 999988887777"]
    subgraph dmz["DMZ Subnet"]
      ALB[ALB / WAF\nTLS Termination]
    end

    subgraph app_tier["App Tier — EKS ng-general"]
      Router[webhook-router\nGo\nTier-1 High\nOutbound HTTP to customer URLs\nNo private IP blocking]
    end

    subgraph data_tier["Data Tier"]
      DDB[(DynamoDB\nhelix-webhook-events\nEvent queue and delivery log\nNo encryption at rest until 2026-Q1 fix)]
    end

    subgraph secrets["Secrets / Infra"]
      Vault[HashiCorp Vault\nIRSA auth\nDynamic AWS creds]
    end

    subgraph cert_store["Device Cert S3\nhelix-prod-device-certs"]
      S3[S3 Bucket\nDevice cert storage\nPre-signed URL TTL — 5min\nObject Lock max 10min\nPost INC-2025-0047]
    end
  end

  OEMCustomer -->|"HTTPS — event subscription config\n(includes customer callback URL)"| ALB
  ALB -->|"HTTP — internal"| Router
  Router -->|"AWS SDK\nIRSA + Vault creds\nRead Write events"| DDB
  Router -->|"HTTPS — outbound delivery\nNo private IP block — HELIX-1822\nNo allow-list of customer domains"| CustomerURL
  Router -->|"HTTPS — S3 SDK\nPre-signed URL generation\nTTL now capped at 5min"| S3
  Router -->|"Vault Agent\nIRSA auth"| Vault
  Vault -->|"Dynamic AWS creds\n(DynamoDB + S3 access)"| Router
  Router -.->|"SSRF risk path\nif customer URL = 169.254.169.254\nNode IAM role theft possible"| IMDS
