flowchart TD
  subgraph internet["Internet (Untrusted)"]
    Browser([End User / OEM Portal\nBrowser])
    Stripe([Stripe API\nExternal Vendor])
  end

  subgraph vpc["VPC — prod account 999988887777 / us-west-2"]
    subgraph dmz["DMZ Subnet"]
      ALB[ALB / WAF\nTLS Termination]
    end

    subgraph app_tier["App Tier — EKS ng-general"]
      API[payments-api\nPython FastAPI\nTier-0 Critical]
    end

    subgraph isolated["Isolated Subnet — EKS ng-pii"]
      PiiV[pii-vault\nPython\nTier-2 Critical]
    end

    subgraph data_tier["Data Tier — Private Subnet"]
      DB[(payments-prod-pg\nRDS PostgreSQL\nEncrypted KMS)]
      Redis[(Redis / ElastiCache\nSession Cache\nNo Auth)]
    end

    subgraph secrets["Secrets / Infra"]
      Vault[HashiCorp Vault\nDynamic Secrets\nPKI Engine]
    end
  end

  Browser -->|"HTTPS / TLS 1.3"| ALB
  ALB -->|"HTTP/2 + JWT Bearer\n(RS256, identity-svc)"| API
  API -->|"mTLS client cert\n+ Vault bearer token"| PiiV
  API -->|"TLS + dynamic creds\n(Vault lease 1h)"| DB
  API -->|"HTTPS + restricted API key\n(stored in Vault)"| Stripe
  API -->|"Vault Agent sidecar\nIRSA auth"| Vault
  Vault -->|"Dynamic PostgreSQL creds\n(TTL 1h)"| API
  API -->|"TLS (no auth)\nVPC-private only"| Redis
  PiiV -->|"IAM auth\nVault db role"| DB
  PiiV -->|"AppRole auth\nVault PKI"| Vault
