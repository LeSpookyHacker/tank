# Required: Anthropic API key (used for entity extraction, chat, reports, vision).
# Tank uses claude-sonnet-4-6 for every call.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: SQLite database location.
# Default: ~/.tank/db.sqlite
TANK_DB_PATH=

# Optional: your employer's internal TLD (e.g. "acme.internal" or "eng.acme.com").
# Hostnames matching this TLD are redacted to [INTERNAL_HOST_<n>].
# Built-in TLDs (.internal, .corp, .local, .lan, .intra) are always redacted.
TANK_INTERNAL_TLD=

# Optional: API key to gate all Tank endpoints (except /healthz and /static).
# When set, every browser/API request must send "X-Tank-Key: <value>".
# Tank's own UI reads this from localStorage key "tank-api-key".
# STRONGLY RECOMMENDED if you change TANK_BIND_HOST from 127.0.0.1.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TANK_API_KEY=

# Optional: server bind address.
# Default: 127.0.0.1:8000
# WARNING: changing TANK_BIND_HOST to 0.0.0.0 without also setting
# TANK_API_KEY exposes all data and API calls to the network unauthenticated.
TANK_BIND_HOST=
TANK_BIND_PORT=

# Optional: daily nudge digest time (HH:MM, local time).
# Default: 08:00
TANK_DIGEST_TIME=

# Optional: enable spaCy-based person-name redaction.
# Off by default (degrades conversational utility).
# Set to 1 to enable. Requires `python -m spacy download en_core_web_sm`.
TANK_ENABLE_PERSON_REDACTION=

# Optional: production mode. Disables uvicorn --reload.
# Set to "prod" on any always-on host (dev VM, server, systemd unit).
# Without prod, --reload is on, which pegs CPU watching the filesystem
# and drops in-flight chat streams whenever a file changes.
# Default: dev
TANK_ENV=

# Optional: explicit timezone for scheduler jobs (digest_time, reflection
# day, journal prompt). If unset, the VM's local time is used — which is
# usually UTC on a hosted VM and probably NOT what you want.
# Examples: "America/Los_Angeles", "Europe/Berlin", "Asia/Tokyo".
TANK_TIMEZONE=
