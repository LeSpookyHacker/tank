# Required: Anthropic API key (used for entity extraction, chat, reports, vision).
# Tank uses claude-sonnet-4-6 for chat and claude-haiku-4-5-20251001 for extraction tasks.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: SQLite database location.
# Default: ~/.tank/db.sqlite
TANK_DB_PATH=

# Optional: your employer's internal TLD (e.g. "acme.internal" or "eng.acme.com").
# Hostnames matching this TLD are redacted to [INTERNAL_HOST_<n>].
# Built-in TLDs (.internal, .corp, .local, .lan, .intra) are always redacted.
TANK_INTERNAL_TLD=

# Optional: API key to gate all Tank endpoints (except /healthz and /static).
# Authentication uses HttpOnly session cookies (SameSite=strict) — the key is
# never stored in localStorage or other browser-readable storage. Authenticate
# once via POST /api/auth/session; the browser cookie handles subsequent requests.
# STRONGLY RECOMMENDED if you change TANK_BIND_HOST from 127.0.0.1.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TANK_API_KEY=

# Optional: server bind address.
# Default: 127.0.0.1:8000
# WARNING: changing TANK_BIND_HOST to 0.0.0.0 without also setting
# TANK_API_KEY exposes all data and API calls to the network unauthenticated.
TANK_BIND_HOST=
TANK_BIND_PORT=

# Optional: daily nudge digest time (HH:MM, local time).
# Default: 08:00
TANK_DIGEST_TIME=

# Optional: enable spaCy-based person-name redaction.
# Off by default (degrades conversational utility).
# Set to 1 to enable. Requires `python -m spacy download en_core_web_sm`.
TANK_ENABLE_PERSON_REDACTION=

# Optional: production mode. Disables uvicorn --reload.
# Set to "prod" on any always-on host (dev VM, server, systemd unit).
# Without prod, --reload is on, which pegs CPU watching the filesystem
# and drops in-flight chat streams whenever a file changes.
# Default: dev
TANK_ENV=

# Optional: explicit timezone for scheduler jobs (digest_time, reflection
# day, journal prompt). If unset, the VM's local time is used — which is
# usually UTC on a hosted VM and probably NOT what you want.
# Examples: "America/Los_Angeles", "Europe/Berlin", "Asia/Tokyo".
TANK_TIMEZONE=

# Optional: opt into Anthropic's token-efficient tools beta for chat.
# When set to 1, Tank sends the "anthropic-beta: token-efficient-tools-2025-02-19"
# header on chat requests. This reduces token usage ~14% on tool-heavy turns.
# Only affects the interactive chat stream (not extraction or batch calls).
# Default: off (empty)
TANK_TOOL_TOKEN_EFFICIENT=

# Optional: Anthropic SDK retry budget and timeout ceiling.
# Increase TANK_API_MAX_RETRIES on a flaky network; decrease to fail fast in dev.
# TANK_API_TIMEOUT_SECONDS covers the longest report generations (~600s = 10 min).
# Defaults: 4 retries, 600s timeout.
TANK_API_MAX_RETRIES=
TANK_API_TIMEOUT_SECONDS=

# Optional: log per-call token counts (input, output, cache_read, cache_create) to
# the console for every Claude call. Useful for understanding cost and cache hit rates.
# Set to 1 to enable. Not suitable for prod (high log volume).
TANK_DEBUG_TOKENS=

# Optional: API key for the Nyx vulnerability-disclosure integration.
# When set, POST /api/vulnerabilities/intake requires an X-Nyx-Key header
# matching this value. Leave unset unless you connect the Nyx tool.
TANK_NYX_API_KEY=

# Optional: GitHub personal access token (classic PAT, read:org + repo scopes).
# Required for Settings → Discovery → GitHub org scan and the GitHub repo watcher.
# Leave unset if you don't use GitHub discovery.
TANK_GITHUB_TOKEN=

# Optional: NVD API key for the CVE feed watcher.
# Without this, the CVE watcher skips all fetches.
# Free key: https://nvd.nist.gov/developers/request-an-api-key
TANK_NVD_API_KEY=
